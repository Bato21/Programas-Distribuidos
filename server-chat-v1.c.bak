/*
 * ============================================================
 *  CHAT DISTRIBUIDO — Versión 1: Un servidor, un cliente
 * ============================================================
 *
 *  Lo que hace esta versión:
 *    - El servidor escucha en TCP puerto 8080
 *    - Acepta UNA conexión
 *    - Reenvía al cliente todo lo que el cliente le manda
 *      (eco puro — el "broadcast" de 1 usuario)
 *    - Cuando el cliente envía "QUIT", cierra la conexión
 *
  *  Compilar:  gcc -Wall -g -o server server-chat.c
 *  Ejecutar:  ./server
 *
 * ============================================================
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <arpa/inet.h>

#define PORT     8080
#define BUF_SIZE 512   /* mitad para poder añadir "ECO: " sin truncar */

int main(void) {

    int server_fd = socket(AF_INET, SOCK_STREAM, 0);
    if (server_fd < 0) { perror("socket"); return 1; }

    int opt = 1;
    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt)); /* permite reusar puerto inmediatamente */
    struct sockaddr_in addr = {
        .sin_family      = AF_INET,           /* AF_INET = IPv4 */
        .sin_port        = htons(PORT),      /* htons: host→network byte order */
        .sin_addr.s_addr = INADDR_ANY       /* aceptar de cualquier IP */
    };

    if (bind(server_fd, (struct sockaddr *)&addr, sizeof(addr)) < 0) { /* bind: asigna puerto a socket */
        perror("bind"); return 1;
    }

    if (listen(server_fd, 5) < 0) { perror("listen"); return 1; } /* listen: marca socket como pasivo (acepta conexiones) */

    printf("[SERVER] Escuchando en puerto %d...\n", PORT);
    printf("[SERVER] Esperando un cliente.\n\n");

    struct sockaddr_in client_addr;
    socklen_t client_len = sizeof(client_addr);

    int client_fd = accept(server_fd,     /* accept: acepta una conexión entrante */
                           (struct sockaddr *)&client_addr,
                           &client_len);
    if (client_fd < 0) { perror("accept"); return 1; }

    printf("[SERVER] Cliente conectado desde %s:%d\n",
           inet_ntoa(client_addr.sin_addr),
           ntohs(client_addr.sin_port));

    char buf[BUF_SIZE];
    char respuesta[BUF_SIZE + 8];  /* espacio extra para "ECO: " + "\n" */

    while (1) {
        int n = recv(client_fd, buf, sizeof(buf) - 1, 0); /* recv: recibe datos del cliente */

        if (n <= 0) {
            printf("[SERVER] Cliente desconectado.\n");
            break;
        }

        buf[n] = '\0';
        if (n > 0 && buf[n-1] == '\n') buf[--n] = '\0'; /* quitar '\n' */

        printf("[SERVER] Recibido: \"%s\"\n", buf);

        /* Comando especial: QUIT */
        if (strcmp(buf, "QUIT") == 0) {
            send(client_fd, "OK Hasta luego\n", 15, 0);
            printf("[SERVER] Cliente pidió QUIT.\n");
            break;
        }
        /* responder con el mensaje eco */
        snprintf(respuesta, sizeof(respuesta), "ECO: %s\n", buf);
        send(client_fd, respuesta, strlen(respuesta), 0);
    }

    close(client_fd);
    close(server_fd);
    printf("[SERVER] Terminado.\n");
    return 0;
}
